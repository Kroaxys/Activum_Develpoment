<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PRG1_MAUI_ERP_Activum.View.LoginPage"
             Title="LoginPage">
    <Grid RowDefinitions="35,30,45,30,45,45,450, 45"
          ColumnDefinitions="498, 498, *"
          Margin="20 20"
          >

        <Label Text="Welcome back"
               Grid.Row="0"
               Grid.Column="0"
               Margin="0,0,0,20"
               />

        <Label Text="Email"
               Grid.Row="1"
               Grid.Column="0"
               />
        <Entry
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            />
        <Label Text="@activum.se"
               Grid.Row="2"
               Grid.Column="3"
               Margin="0,10,0,0"
               
               />

        <Label Text="Password"
               Grid.Row="3"
               Grid.Column="0"
               />
        <Entry
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            />

        <Button
            Grid.Row="5"
            Grid.Column="1"
            />

        <Button Grid.Row="7"
                Grid.Column="0"
                Margin="0,0,0,0 "/>
        <Image Grid.Row="7"
                Grid.Column="2"/>

    </Grid>
</ContentPage>