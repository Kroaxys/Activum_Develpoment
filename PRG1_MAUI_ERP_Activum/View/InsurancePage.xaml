<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PRG1_MAUI_ERP_Activum.View.InsurancePage"
             Title="Försäkringar"
             BackgroundImageSource="bakgrund_2.png">
    <Grid
        RowDefinitions="auto,auto,auto,auto,*,45"
        ColumnDefinitions="*"
        RowSpacing="10"
        Padding="10"
        >

        <Label
            Text="Personnr/Kundnr"
            FontSize="Medium"
            Grid.Row="0"
            Grid.Column="0"
            />

        <Entry
            Placeholder="ååååmmdd"
            Grid.Row="1"
            Grid.Column="0"
            />

        <Button
            Text="Sök"
            Grid.Row="2"
            Grid.Column="0"
            />
        <Label
            Text=""
            Grid.Row="3"
            Grid.Column="0"
            Margin="0,50"
            />
        <Image Source="logga_activum_vit.png"
               Grid.Row="5"
               Grid.Column="0"
               HorizontalOptions="End"
               />

    </Grid>
</ContentPage>