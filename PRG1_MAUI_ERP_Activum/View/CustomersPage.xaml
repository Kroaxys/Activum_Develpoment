<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PRG1_MAUI_ERP_Activum.View.CustomersPage"
             Title="Kunder">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,Auto">
        <Label
            Margin="10 30 10 30"
            Grid.Row="0"
            Grid.Column="0"
            Text="Kunder"
            FontSize="Large"/>
        
        <Label
            Margin="10 30 10 30"
            Text="Personnr/Kundnr"
            FontSize="Large"
            Grid.Row="1"
            Grid.Column="0"
            WidthRequest="300"/>

        <Entry
            Margin="10 30 10 30"
            Grid.Column="0"
            Grid.Row="2"
            Text="ddmmyy-XXXX"/>

        <Button
            Margin="10 30 10 30"
            Grid.Row="3"
            Grid.Column="0"
            Text="Sök"
            />

        <Label
            Margin="10 30 10 30"
            Grid.Row="4"
            Grid.Column="0"
            Text="Försäkrings Anmälan"
            FontSize="Large"/>
    </Grid>
</ContentPage>